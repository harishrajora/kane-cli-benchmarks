# Copy to .env and fill in. .env is gitignored.
# APP_KEY: generate with  echo "base64:$(openssl rand -base64 32)"
APP_KEY=
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Benchmark-only admin login, set after first start (replaces the default admin@admin.com / password)
ADMIN_EMAIL=admin@bench.local
ADMIN_PASSWORD=
# BookStack API token for the seed script (created in step 3)
API_TOKEN_ID=
API_TOKEN_SECRET=
# Shared password for the seeded users (Erin, Ethan, Vera, Hana)
USER_PASSWORD=
